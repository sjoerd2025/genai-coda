# Environment example for genai-coda

# ADK2 settings
ADK2_API_KEY=
PROCESSORS=app.processors.adk2_processor.ADK2Processor,app.services.genai_processors.ExtractPRProcessor

# Prometheus
PROMETHEUS_ENABLED=true

# GitHub
GITHUB_TOKEN=

# App settings (examples)
REPOS_DIR=/repos
DATABASE_URL=postgresql+psycopg2://user:pass@db:5432/dbname
REDIS_URL=redis://redis:6379/0
API_KEY=
